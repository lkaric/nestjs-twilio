{
  "name": "nestjs-twilio",
  "version": "5.0.0",
  "type": "module",
  "description": "Injectable Twilio client for NestJS, with webhook signature validation, TwiML responses, and access tokens",
  "license": "MIT",
  "author": {
    "name": "Lazar Karic",
    "email": "lazar@mm.st",
    "url": "https://lazar.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkaric/nestjs-twilio.git"
  },
  "homepage": "https://nestjs-twilio.lazar.sh",
  "bugs": "https://github.com/lkaric/nestjs-twilio/issues",
  "private": false,
  "keywords": [
    "nestjs",
    "twilio",
    "sms",
    "voice",
    "twiml",
    "webhook",
    "client",
    "sdk",
    "typescript",
    "nestjs-twilio",
    "twilio-nestjs"
  ],
  "sideEffects": false,
  "source": "lib/index.ts",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./terminus": {
      "import": {
        "types": "./dist/esm/terminus/index.d.ts",
        "default": "./dist/esm/terminus/index.js"
      },
      "require": {
        "types": "./dist/cjs/terminus/index.d.ts",
        "default": "./dist/cjs/terminus/index.js"
      }
    }
  },
  "files": [
    "dist",
    "llms.txt",
    "terminus"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm clean:dist && pnpm build:cjs && pnpm build:esm && pnpm build:stubs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:stubs": "node scripts/write-dist-stubs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm clean:test && vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "type-check": "tsc --noEmit",
    "lint": "oxlint lib scripts examples",
    "lint:fix": "oxlint lib scripts examples --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "pnpm build && publint --strict && attw --pack . && pnpm check:runtime",
    "clean:dist": "rimraf dist",
    "clean:test": "rimraf coverage",
    "prepare": "lefthook install || true",
    "check:runtime": "node scripts/check-dual-build.mjs",
    "docs:dev": "pnpm --filter @nestjs-twilio/docs dev",
    "docs:build": "pnpm --filter @nestjs-twilio/docs build",
    "docs:preview": "pnpm --filter @nestjs-twilio/docs preview",
    "example:build": "pnpm --filter @nestjs-twilio/example-basic build",
    "example:start": "pnpm --filter @nestjs-twilio/example-basic start"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/terminus": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.8.0",
    "twilio": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/terminus": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/testing": "12.0.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "12.0.9",
    "@swc/core": "^1.16.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "dotenv": "^17.2.4",
    "jsonwebtoken": "^9.0.3",
    "lefthook": "^2.1.14",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "publint": "^0.3.24",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "semantic-release": "^25.0.9",
    "twilio": "^6.1.1",
    "typescript": "5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  }
}
