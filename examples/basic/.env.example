# Default account, used by TwilioModule.forRoot().
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Sender used by POST /sms, in E.164 format.
TWILIO_PHONE_NUMBER=+15550001111

# Subaccount, used by TwilioModule.registerClient({ name: 'billing' }).
TWILIO_BILLING_ACCOUNT_SID=ACyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
TWILIO_BILLING_AUTH_TOKEN=your_billing_auth_token

# API key credentials, used by the `realtime` client for /token routes.
# Access Tokens must be signed with an API key, never an auth token.
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_key_secret

# Public origin Twilio reaches the app on. Set this when running behind a
# tunnel or proxy so signature validation rebuilds the URL Twilio signed,
# rather than the internal one.
# PUBLIC_URL=https://your-tunnel.example.com

# PORT=3000
